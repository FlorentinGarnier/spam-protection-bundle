{
    "name": "florentingarnier/spam-protection-bundle",
    "description": "Symfony integration of florentingarnier/spam-protection: a form type, its JavaScript solver and the IP list refresh command.",
    "type": "symfony-bundle",
    "license": "MIT",
    "homepage": "https://github.com/FlorentinGarnier/spam-protection-bundle",
    "authors": [
        {
            "name": "Florentin Garnier",
            "homepage": "https://github.com/FlorentinGarnier"
        }
    ],
    "support": {
        "issues": "https://github.com/FlorentinGarnier/spam-protection-bundle/issues",
        "source": "https://github.com/FlorentinGarnier/spam-protection-bundle",
        "security": "https://github.com/FlorentinGarnier/spam-protection-bundle/security/policy"
    },
    "keywords": [
        "captcha",
        "spam",
        "symfony",
        "form"
    ],
    "require": {
        "php": "^8.2",
        "florentingarnier/spam-protection": "^0.2",
        "psr/log": "^2.0 || ^3.0",
        "symfony/config": "^5.4 || ^6.4 || ^7.4 || ^8.0",
        "symfony/console": "^5.4 || ^6.4 || ^7.4 || ^8.0",
        "symfony/dependency-injection": "^5.4 || ^6.4 || ^7.4 || ^8.0",
        "symfony/form": "^5.4 || ^6.4 || ^7.4 || ^8.0",
        "symfony/http-client-contracts": "^2.5 || ^3.0",
        "symfony/http-foundation": "^5.4 || ^6.4 || ^7.4 || ^8.0",
        "symfony/http-kernel": "^5.4 || ^6.4 || ^7.4 || ^8.0",
        "symfony/lock": "^5.4 || ^6.4 || ^7.4 || ^8.0",
        "symfony/translation-contracts": "^2.5 || ^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5 || ^11.5 || ^12.0",
        "symfony/cache": "^5.4 || ^6.4 || ^7.4 || ^8.0",
        "symfony/http-client": "^5.4 || ^6.4 || ^7.4 || ^8.0"
    },
    "suggest": {
        "symfony/monolog-bundle": "Writes accepted and rejected submissions to the spam_protection channel",
        "symfony/twig-bundle": "Registers the form theme that hides the protection fields"
    },
    "autoload": {
        "psr-4": {
            "FlorentinGarnier\\SpamProtectionBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "FlorentinGarnier\\SpamProtectionBundle\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    }
}
